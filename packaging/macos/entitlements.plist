<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for Filmcraft. Deliberately minimal: the app loads no
     unsigned code and is not sandboxed (it opens files by path, from the command line and
     drag-and-drop). Add exceptions here only with a reason in a comment. -->
<plist version="1.0">
<dict>
  <!-- Voice-over recording reads the microphone; the hardened runtime blocks audio input without
       this (Info.plist.in carries the matching NSMicrophoneUsageDescription). -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- The Reaction page's browser engine (CEF) is a framework re-signed at packaging. A
       Developer ID build matches it by team identity; an ad-hoc build shares none, and the
       hardened runtime would refuse to load the framework without this. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
