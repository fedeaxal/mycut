<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif?>
  <?ifndef HasRuntimeLibraries ?>
  <?define HasRuntimeLibraries=0 ?>
  <?endif?>
  <?ifndef HasRuntimeLicences ?>
  <?define HasRuntimeLicences=0 ?>
  <?endif?>
  <Package Name="Reacut" Manufacturer="Learning Machines LLC" Version="$(var.Version)" UpgradeCode="31E6FB14-9DBC-41DD-B24B-26B71FB31B62" Scope="perUserOrMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="Reacut" Manufacturer="Learning Machines LLC" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Reacut is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="FilmcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="FilmcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://getartcraft.com/apps/filmcraft" />
    <Property Id="ARPURLUPDATEINFO" Value="https://getartcraft.com/apps/filmcraft" />
    <Property Id="ARPHELPLINK" Value="https://discord.gg/artcraft" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CraftSuiteFolder" Name="ArtCraft">
        <Directory Id="INSTALLFOLDER" Name="Reacut" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Reacut" Level="1">
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif?>
      <?if $(var.HasRuntimeLibraries) = 1 ?>
      <ComponentGroupRef Id="RuntimeLibraries" />
      <?endif?>
      <?if $(var.HasRuntimeLicences) = 1 ?>
      <ComponentGroupRef Id="RuntimeLicences" />
      <?endif?>
      <ComponentGroupRef Id="FilmcraftFiles" />
    </Feature>
  <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="NOT Installed" />
    </UI>
  </Package>

  <Fragment>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif?>
    <?if $(var.HasRuntimeLibraries) = 1 ?>
    <!-- FFmpeg, sherpa-onnx, ONNX Runtime and the VC++ runtime DLLs the executables
         load at run time. package.ps1 stages them unconditionally and sets the flag. -->
    <ComponentGroup Id="RuntimeLibraries" Directory="INSTALLFOLDER">
      <Files Include="$(var.BinDir)\*.dll" />
    </ComponentGroup>
    <?endif?>
    <?if $(var.HasRuntimeLicences) = 1 ?>
    <!-- The licences of those libraries, when package.ps1 staged any (FFMPEG_DIR's copyright
         files). A glob that matches nothing is not a valid ComponentGroup, hence the second flag. -->
    <ComponentGroup Id="RuntimeLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.LicDir)\**" />
    </ComponentGroup>
    <?endif?>
    <ComponentGroup Id="FilmcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="FilmcraftApp" Guid="15933017-925B-4963-8992-52000EB26AAA">
        <File Id="FilmcraftNotice" Source="$(var.BinDir)\NOTICE" KeyPath="no" />
        <File Id="FilmcraftExe" Source="$(var.BinDir)\reacut.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Reacut" Description="Reacut" WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="FilmcraftIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\reacut.exe" Value="[#FilmcraftExe]" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Reacut" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="FilmcraftCli">
        <File Id="FilmcraftCliExe" Source="$(var.BinDir)\reacut-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
